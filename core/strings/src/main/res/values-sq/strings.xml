    <string name="recognition_provider_dialog_format_auth">Vërtetimi %s:</string>
    <string name="audd_help_dialog_message"><![CDATA[AudD është një shërbim me pagesë që ofron një provë 14-ditore falas. Për të përdorur këtë shërbim, duhet të krijoni një llogari dhe të merrni tokenin tuaj privat API. <a href=%1$s>Regjistrohu</a> nëse nuk e ke ende.]]></string>
    <string name="audd_help_dialog_message_empty_token">Mund të provoni ta përdorni shërbimin për qëllime testimi pa dhënë shenjën, por kini parasysh se kjo do të kufizojë njohjet tuaja ditore.</string>
    <string name="acr_cloud_help_dialog_message"><![CDATA[ACRCloud është një shërbim me pagesë që ofron mundësinë e një periudhe prove falas dhe përdorim të kufizuar për qëllime zhvillimi. Për të përdorur këtë shërbim, duhet të krijoni një llogari dhe të regjistroni një projekt. Nëse hasni ndonjë vështirësi, ju lutemi referojuni <a href=%1$s>ky udhëzues</a>.]]></string>
    <string name="acr_cloud_help_dialog_steps_title">Ju lutemi kushtojini vëmendje këtyre hapave:</string>
    <string name="acr_cloud_help_dialog_step1">Zgjidhni rajonin gjeografik më afër jush për të minimizuar vonesën e internetit</string>
    <string name="acr_cloud_help_dialog_step2">Cakto burimin e audios në \"Audio e regjistruar\"</string>
    <string name="acr_cloud_help_dialog_step3">Vendosni motorin audio sipas zgjedhjes suaj. Opsioni \"Gjurmë gishtash audio\" është më i sakti për përdorim të përgjithshëm</string>
    <string name="acr_cloud_help_dialog_step4">Kontrolloni të gjitha kutitë për integrimin e ID-së së palës së tretë</string>
